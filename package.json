{
  "name": "rain-letter-music",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts src/workbench/*.test.ts src/workbench/studio/*.test.ts src/audio/*.test.ts",
    "assets": "node scripts/download-assets.mjs",
    "export:score": "node scripts/export-score.ts",
    "verify:browser": "node scripts/verify-browser.mjs",
    "verify:workbench": "node scripts/verify-workbench.mjs",
    "verify:loop-audio": "node scripts/verify-loop-audio.mjs",
    "verify:comparison": "node scripts/verify-comparison.mjs",
    "verify:boundaries": "node scripts/verify-boundaries.mjs",
    "verify:all": "npm test && npm run build && npm run verify:imports && npm run verify:workbench && npm run verify:loop-audio && npm run verify:comparison && npm run verify:boundaries && npm run verify:browser",
    "authoring:kit": "node scripts/build-authoring-kit.mjs",
    "predev": "npm run authoring:kit",
    "prebuild": "npm run authoring:kit",
    "verify:imports": "node scripts/verify-imports.mjs",
    "test:service": "node --test src/service/**/*.test.ts src/server/*.test.ts",
    "serve": "node src/server/dev.ts serve",
    "mcp": "node src/server/dev.ts mcp",
    "verify:service": "node scripts/verify-service.mjs && node --test scripts/verify-service-boundaries.test.mjs scripts/verify-yue2-ui.test.mjs scripts/verify-speech-ui.test.mjs",
    "build:binary": "npm run build && node scripts/build-binary.mjs",
    "verify:binary": "node scripts/verify-binary.mjs",
    "verify:yue2:real": "node scripts/verify-yue2-real.mjs",
    "verify:speech": "node --test scripts/verify-speech-ui.test.mjs",
    "verify:tts:real": "node scripts/verify-tts-real.mjs && node scripts/verify-tts-default-real.mjs",
    "verify:studio": "node --test scripts/verify-studio-ui.test.mjs scripts/verify-emotion-strength-ui.test.mjs scripts/verify-player-menu-ui.test.mjs scripts/verify-speed-ui.test.mjs"
    ,"perf:studio-scroll": "node scripts/perf-studio-scroll.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@soundtouchjs/core": "2.1.1",
    "@tonejs/midi": "^2.0.28",
    "@wasm-audio-decoders/flac": "0.2.10",
    "mpg123-decoder": "1.0.3",
    "wav-decoder": "1.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bun": "1.4.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
