{
  "name": "rain-letter-music",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts src/workbench/*.test.ts src/workbench/studio/*.test.ts src/audio/*.test.ts src/workbench/speech/*.test.ts",
    "assets": "node scripts/download-assets.mjs",
    "export:score": "node scripts/export-score.ts",
    "verify:all": "npm test && npm run build && npm run test:service && npm run verify:studio && npm run verify:score",
    "authoring:kit": "node scripts/build-authoring-kit.mjs",
    "predev": "npm run authoring:kit",
    "prebuild": "npm run authoring:kit",
    "test:service": "node --test src/service/**/*.test.ts src/server/*.test.ts",
    "serve": "node src/server/dev.ts serve",
    "mcp": "node src/server/dev.ts mcp",
    "verify:service": "npm run test:service && npm run verify:score",
    "build:binary": "npm run build && node scripts/build-binary.mjs",
    "verify:binary": "node scripts/verify-binary.mjs",
    "verify:yue2:real": "node scripts/verify-yue2-real.mjs",
    "verify:speech": "node --test scripts/verify-speech-ui.test.mjs",
    "verify:tts:real": "node scripts/verify-tts-real.mjs && node scripts/verify-tts-default-real.mjs",
    "verify:studio": "node --test scripts/verify-studio-ui.test.mjs scripts/verify-emotion-strength-ui.test.mjs scripts/verify-player-menu-ui.test.mjs scripts/verify-speed-ui.test.mjs scripts/verify-studio-conversion-ui.test.mjs scripts/verify-conversion-ui.test.mjs",
    "perf:studio-scroll": "node scripts/perf-studio-scroll.mjs",
    "verify:resources:real": "node scripts/verify-resources-real.ts",
    "verify:resources": "node --test scripts/verify-resources-ui.test.mjs",
    "verify:resources:binary:real": "node scripts/verify-resources-binary-real.mjs",
    "verify:score": "node --test scripts/verify-score-context-ui.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@soundtouchjs/core": "2.1.1",
    "@tonejs/midi": "^2.0.28",
    "@wasm-audio-decoders/flac": "0.2.10",
    "mpg123-decoder": "1.0.3",
    "wav-decoder": "1.3.0",
    "zod": "4.3.6",
    "codec-parser": "2.5.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "bun": "1.4.2",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
