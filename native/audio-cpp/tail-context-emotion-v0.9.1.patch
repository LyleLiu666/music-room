@@ -0,0 +1,16 @@
+#pragma once
+#include <stdexcept>
+#include <vector>
+namespace engine::models::index_tts2 {
+// Blend two learned conditions; do not attenuate a condition toward a zero vector.
+inline std::vector<float> mix_reference_emotion_strength(
+    const std::vector<float>& reference, const std::vector<float>& calm, float alpha) {
+    if (!(alpha >= 0.0F && alpha <= 1.0F) || reference.size() != calm.size())
+        throw std::runtime_error("IndexTTS2 reference emotion strength shape or range invalid");
+    if (alpha == 1.0F) return reference;
+    std::vector<float> result(reference.size());
+    for (size_t i = 0; i < result.size(); ++i)
+        result[i] = calm[i] + alpha * (reference[i] - calm[i]);
+    return result;
+}
+} // namespace engine::models::index_tts2
